# Core
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
# Any localhost origin is accepted automatically outside production.
CLIENT_ORIGIN=http://localhost:8081

# Database. SQLite is the default for local development; switch the provider in
# prisma/schema.prisma to "postgresql" when pointing at a hosted database.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmaconnect?schema=public"

# Auth. Required in production; local development falls back to a shared development secret.
SESSION_TOKEN_SECRET=replace_with_a_long_random_session_secret
SESSION_TOKEN_TTL_DAYS=30

# Payments. Leave empty to use the demo checkout path instead of a live gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signed links for invoice PDFs and prescription images.
INVOICE_LINK_SECRET=replace_with_a_long_random_invoice_link_secret

# File storage. Without S3_BUCKET_NAME, uploads are written to backend/storage on disk.
STORAGE_PUBLIC_BASE_URL=
S3_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Push notifications through Expo. Set PUSH_DELIVERY_ENABLED=false to store notifications
# in the inbox without sending them to devices.
PUSH_DELIVERY_ENABLED=true
EXPO_PUSH_ACCESS_TOKEN=
